# Database (SQLite for local dev; use PostgreSQL+pgvector in production)
DATABASE_URL=sqlite+aiosqlite:///./projectintel.db
# DATABASE_URL=postgresql+asyncpg://projectintel:projectintel@localhost:5432/projectintel
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# AI (Google Gemini — OpenAI-compatible chat completions)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.6-flash

# Langfuse tracing (optional; no confidential prompt/response text is exported)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=development

# Security
MAX_AI_TOKENS_PER_REQUEST=3072
SENSITIVE_DATA_ACTION=block
CORS_ORIGINS=http://localhost:5173

# Orchestration
ORCHESTRATION_MODE=workflow

# Durable semantic project memory (ChromaDB)
PROJECT_MEMORY_ENABLED=true
CHROMA_PERSIST_PATH=./chroma_data
PROJECT_SIMILARITY_THRESHOLD=0.30

# App
APP_NAME=Planora AI
DEBUG=true
